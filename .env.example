# Copy this file to .env and fill in real values for local development.
# On Railway (or any other host), set these as environment variables in the
# platform's dashboard instead of committing a .env file.

# Discord Developer Portal -> your application -> Bot -> Token
DISCORD_BOT_TOKEN=

# Optional: your own Discord user id (and/or co-developers'), comma-separated
# if more than one. Anyone listed here can run /story-* owner commands on
# ANY server the bot is in, in addition to that server's real owner -- handy
# for managing/testing across servers you don't personally own.
BOT_ADMIN_USER_IDS=

# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Paste the ENTIRE downloaded JSON file here as one single-line
# string (this is what makes it safe to deploy without committing a secrets
# file to your repo).
FIREBASE_CREDENTIALS_JSON=

# --- AI provider selection ---
# Which provider powers episode writing/validation ("main") vs DM
# classification/setting-choice ("fast"). Each can be different.
# Supported values: anthropic, gemini, openai, grok
AI_PROVIDER_MAIN=anthropic
AI_PROVIDER_FAST=anthropic

# Only fill in the API key(s) for the provider(s) you actually selected above.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Optional: override the model string for either role. Leave blank to use
# the selected provider's own built-in default (see services/ai_providers/).
# AI_MODEL_MAIN=
# AI_MODEL_FAST=

# Optional: enables a periodic local backup of story data (Firebase is
# always the live database -- this is a fallback export only, not a second
# store the bot reads from). Point this at a path on a mounted Railway
# Volume so it actually survives restarts; see the README's "Local backup"
# section. Leave blank to disable entirely (default).
LOCAL_BACKUP_DIR=
# LOCAL_BACKUP_INTERVAL_MINUTES=30
